#!/usr/bin/with-contenv bashio
set -e

CONFIG_DIR=/data/esphome-config
mkdir -p "${CONFIG_DIR}"

# Immer die gebündelte Vorlage übernehmen, damit Fixes/Änderungen am Add-on
# nach einem Update wirksam werden (sonst bliebe eine ggf. veraltete/fehler-
# hafte Kopie für immer liegen). Die zuletzt hochgeladene Setlist wird direkt
# danach aus last_setlist.* erneut eingetragen, falls vorhanden.
cp /app/esp32-matrix-portal-s3.yaml "${CONFIG_DIR}/esp32-matrix-portal-s3.yaml"
cp /app/parse_setlist.py "${CONFIG_DIR}/parse_setlist.py"

# Kein `ls ... | head` hier: bashio setzt errexit+pipefail, und `ls` liefert
# Exit 2, wenn das Glob nicht matcht -- der Service würde dann beim ersten
# Start (noch keine Setlist hochgeladen) still mit Code 2 abbrechen.
LAST_SETLIST=""
for candidate in "${CONFIG_DIR}"/last_setlist.*; do
  if [ -f "${candidate}" ]; then
    LAST_SETLIST="${candidate}"
    break
  fi
done
if [ -n "${LAST_SETLIST}" ]; then
  # Eine kaputte gespeicherte Setlist darf den Add-on-Start nicht verhindern --
  # die YAML-Vorlage bleibt dann einfach bei ihren Standardwerten.
  python3 "${CONFIG_DIR}/parse_setlist.py" "${LAST_SETLIST}" "${CONFIG_DIR}/esp32-matrix-portal-s3.yaml" \
    || bashio::log.warning "Konnte ${LAST_SETLIST} nicht einlesen -- starte mit Vorlage."
fi

WIFI_SSID=$(bashio::config 'wifi_ssid')
WIFI_PASSWORD=$(bashio::config 'wifi_password')

cat > "${CONFIG_DIR}/secrets.yaml" <<EOF
wifi_ssid: "${WIFI_SSID}"
wifi_password: "${WIFI_PASSWORD}"
EOF

export SONGLIST_CONFIG_DIR="${CONFIG_DIR}"
export SONGLIST_DEVICE_IP="$(bashio::config 'device_ip')"

cd /app
exec python3 /app/app.py
